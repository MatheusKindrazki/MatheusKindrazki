# Public edition of Jarvis (site chat). Off unless this is set to `enabled`.
JARVIS_PUBLIC_MODE=
# Claude API key used only by the public edition. Set a spend limit on it.
ANTHROPIC_API_KEY=
# Model for the public edition.
JARVIS_PUBLIC_MODEL=claude-opus-5-5
# Max public chat requests per day, counted PER SERVER INSTANCE (1-5000). This is
# not a spending limit: set the spend limit on the Anthropic API key itself.
JARVIS_PUBLIC_DAILY_CAP=200

# Resend — contact form delivery (https://resend.com)
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=
# Inbox that receives contact form submissions
CONTACT_TO_EMAIL=matheus@kindrazki.dev
# From: address. Use `onboarding@resend.dev` for local/dev; switch to a
# verified domain sender (e.g. `hello@kindrazki.dev`) in production.
CONTACT_FROM_EMAIL=onboarding@resend.dev
